# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Storyblok → Settings → Access Tokens → the "Preview" token
STORYBLOK_ACCESS_TOKEN=
# eu unless your space is in another region (us / ca / ap)
STORYBLOK_REGION=eu
# draft = show unpublished changes (localhost + the preview deployment the Visual Editor uses)
# published = live site. Leave empty: draft in dev, published in production.
STORYBLOK_VERSION=
# Any random string; also used in the Storyblok webhook URL (/api/revalidate?secret=...)
STORYBLOK_WEBHOOK_SECRET=

# Only for `npm run storyblok:setup` (never needed on Vercel)
STORYBLOK_SPACE_ID=
STORYBLOK_PERSONAL_TOKEN=
