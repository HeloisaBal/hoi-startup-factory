# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Find these at https://www.sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API → Tokens → "Add API token", permission: Viewer. Server-only — never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Only for `npm run sanity:seed-events` (demo events). Role: Editor. Never add this to Vercel.
SANITY_API_WRITE_TOKEN=
